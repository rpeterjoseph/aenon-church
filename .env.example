# Resend (https://resend.com) — used to email form submissions to the team.
RESEND_API_KEY=

# Inbox that receives Contact / Prayer Request / Volunteer submissions.
RESEND_TO_EMAIL=aenonchurch@gmail.com

# Sender address. Until aenonchurch.com is verified in Resend, use their
# shared test domain — it can only deliver to the Resend account's own
# signup email in that state. Once the domain is verified, switch to
# something like: Aenon Church Website <noreply@aenonchurch.com>
RESEND_FROM_EMAIL=Aenon Church Website <onboarding@resend.dev>
