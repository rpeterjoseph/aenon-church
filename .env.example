# Secret required to bypass maintenance mode (see src/app/api/maintenance-bypass/route.ts).
# Set this in your deployment environment; do not commit the real value.
MAINTENANCE_BYPASS_SECRET=

# Optional: enables the Latest Sermon embed (homepage + /sermons) to
# auto-update from the real youtube.com/aenonchurch channel instead of
# the manual fallback video ID in src/lib/config.ts. Create a key at
# https://console.cloud.google.com/apis/credentials with the "YouTube
# Data API v3" enabled.
YOUTUBE_API_KEY=

# Optional: the exact channel ID (starts with "UC"), if known — skips
# resolving it from the handle below on every cache refresh.
YOUTUBE_CHANNEL_ID=

# Optional: override the channel handle used to resolve the channel ID
# when YOUTUBE_CHANNEL_ID isn't set. Defaults to "aenonchurch", matching
# https://www.youtube.com/aenonchurch.
YOUTUBE_CHANNEL_HANDLE=
